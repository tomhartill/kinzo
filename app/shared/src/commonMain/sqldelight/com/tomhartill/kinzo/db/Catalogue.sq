-- The exercise and equipment catalogue. Rows from the bundled catalogue have source
-- 'free-exercise-db', or 'kinzo' for Kinzo's own machines, machine exercises and groups;
-- user-created custom rows arrive later with source 'custom'.
-- Columns mirror the server schema so sync can map them one to one. Times are epoch
-- milliseconds.

CREATE TABLE equipment (
    id                  TEXT NOT NULL PRIMARY KEY,
    name                TEXT NOT NULL,
    type                TEXT NOT NULL,
    description         TEXT,
    setup_instructions  TEXT,
    source              TEXT NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER
);

CREATE TABLE exercise (
    id                  TEXT NOT NULL PRIMARY KEY,
    name                TEXT NOT NULL,
    description         TEXT,
    -- One step per line.
    instructions        TEXT NOT NULL,
    equipment_id        TEXT,
    measurement_type    TEXT NOT NULL,
    source              TEXT NOT NULL,
    source_ref          TEXT,
    -- The key of its pictogram in files/exercise_icons.json, such as 'squat'.
    icon                TEXT,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    -- The group of variations it belongs to, such as every bench press, or null.
    group_id            TEXT,
    -- Other names people search by, such as "Military Press" for the overhead press, one per
    -- line, or null.
    aliases             TEXT
);

-- Variations of one movement shown together, such as every bench press or chest press.
CREATE TABLE exercise_group (
    id                  TEXT NOT NULL PRIMARY KEY,
    name                TEXT NOT NULL,
    icon                TEXT,
    source              TEXT NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER,
    -- Other names for the movement, one per line, or null. Searching one lists every variation.
    aliases             TEXT
);

-- Named gym machines, such as a leg press or a pec deck, for the machine scan. Each belongs to
-- one generic equipment type (machine, cable and so on) and supports several exercises.
CREATE TABLE machine (
    id                  TEXT NOT NULL PRIMARY KEY,
    name                TEXT NOT NULL,
    equipment_id        TEXT,
    -- Other names people use for it, one per line.
    aliases             TEXT NOT NULL,
    description         TEXT,
    source              TEXT NOT NULL,
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER
);

CREATE TABLE machine_exercise (
    machine_id          TEXT NOT NULL,
    exercise_id         TEXT NOT NULL,
    position            INTEGER NOT NULL,
    PRIMARY KEY (machine_id, exercise_id)
);

CREATE TABLE exercise_muscle (
    exercise_id         TEXT NOT NULL,
    muscle              TEXT NOT NULL,
    is_primary          INTEGER NOT NULL,
    PRIMARY KEY (exercise_id, muscle)
);

upsertEquipment:
INSERT OR REPLACE INTO equipment(id, name, type, description, setup_instructions, source, updated_at, deleted_at)
VALUES (:id, :name, :type, NULL, NULL, :source, :updatedAt, NULL);

upsertExercise:
INSERT OR REPLACE INTO exercise(id, name, description, instructions, equipment_id, measurement_type, source, source_ref, icon, updated_at, deleted_at, group_id, aliases)
VALUES (:id, :name, NULL, :instructions, :equipmentId, :measurementType, :source, :sourceRef, :icon, :updatedAt, NULL, :groupId, :aliases);

upsertGroup:
INSERT OR REPLACE INTO exercise_group(id, name, icon, source, updated_at, deleted_at, aliases)
VALUES (:id, :name, :icon, :source, :updatedAt, NULL, :aliases);

-- When the catalogue folds a duplicate exercise into another, logged workouts and saved
-- routines move onto the one that's kept, so no history is lost.
moveWorkoutExercises:
UPDATE workout_exercise SET exercise_id = :toId, updated_at = :now WHERE exercise_id = :fromId;

moveRoutineExercises:
UPDATE routine_exercise SET exercise_id = :toId, updated_at = :now WHERE exercise_id = :fromId;

upsertMachine:
INSERT OR REPLACE INTO machine(id, name, equipment_id, aliases, description, source, updated_at, deleted_at)
VALUES (:id, :name, :equipmentId, :aliases, :description, :source, :updatedAt, NULL);

insertMachineExercise:
INSERT OR REPLACE INTO machine_exercise(machine_id, exercise_id, position)
VALUES (:machineId, :exerciseId, :position);

softDeleteGroupsFromSource:
UPDATE exercise_group SET deleted_at = :now, updated_at = :now
WHERE source = :source AND deleted_at IS NULL;

softDeleteMachinesFromSource:
UPDATE machine SET deleted_at = :now, updated_at = :now
WHERE source = :source AND deleted_at IS NULL;

deleteMachineExercisesFromSource:
DELETE FROM machine_exercise
WHERE machine_id IN (SELECT id FROM machine WHERE source = :source);

insertMuscle:
INSERT OR REPLACE INTO exercise_muscle(exercise_id, muscle, is_primary)
VALUES (:exerciseId, :muscle, :isPrimary);

softDeleteExercisesFromSource:
UPDATE exercise SET deleted_at = :now, updated_at = :now
WHERE source = :source AND deleted_at IS NULL;

softDeleteEquipmentFromSource:
UPDATE equipment SET deleted_at = :now, updated_at = :now
WHERE source = :source AND deleted_at IS NULL;

deleteMusclesFromSource:
DELETE FROM exercise_muscle
WHERE exercise_id IN (SELECT id FROM exercise WHERE source = :source);

exerciseList:
SELECT
    e.id,
    e.name,
    e.measurement_type,
    e.equipment_id,
    eq.name AS equipment_name,
    e.icon,
    COALESCE((SELECT group_concat(m.muscle) FROM exercise_muscle m WHERE m.exercise_id = e.id AND m.is_primary = 1), '') AS primary_muscles,
    COALESCE((SELECT group_concat(m.muscle) FROM exercise_muscle m WHERE m.exercise_id = e.id AND m.is_primary = 0), '') AS secondary_muscles,
    g.id AS group_id,
    g.name AS group_name,
    g.icon AS group_icon,
    e.aliases,
    g.aliases AS group_aliases
FROM exercise e
LEFT JOIN equipment eq ON eq.id = e.equipment_id
LEFT JOIN exercise_group g ON g.id = e.group_id AND g.deleted_at IS NULL
WHERE e.deleted_at IS NULL
ORDER BY e.name COLLATE NOCASE;

-- Deleted rows are still returned: past workouts can reference an exercise that has since
-- left the catalogue.
exerciseById:
SELECT
    e.id,
    e.name,
    e.description,
    e.instructions,
    e.measurement_type,
    e.equipment_id,
    eq.name AS equipment_name,
    e.source,
    e.icon,
    g.id AS group_id,
    g.name AS group_name,
    e.aliases
FROM exercise e
LEFT JOIN equipment eq ON eq.id = e.equipment_id
LEFT JOIN exercise_group g ON g.id = e.group_id AND g.deleted_at IS NULL
WHERE e.id = :id;

-- The other exercises in a group, for an exercise page's list of variations.
groupVariations:
SELECT id, name, icon
FROM exercise
WHERE group_id = :groupId AND id != :exceptId AND deleted_at IS NULL
ORDER BY name COLLATE NOCASE;

musclesForExercise:
SELECT muscle, is_primary
FROM exercise_muscle
WHERE exercise_id = :exerciseId
ORDER BY is_primary DESC, muscle;

equipmentList:
SELECT id, name, type
FROM equipment
WHERE deleted_at IS NULL
ORDER BY name COLLATE NOCASE;

countActiveExercises:
SELECT COUNT(*) FROM exercise WHERE deleted_at IS NULL;

machineList:
SELECT id, name, aliases, description
FROM machine
WHERE deleted_at IS NULL
ORDER BY name COLLATE NOCASE;

machineById:
SELECT id, name, aliases, description
FROM machine
WHERE id = :id;

-- The exercises a machine supports, in the catalogue's order.
machineExerciseIds:
SELECT me.exercise_id
FROM machine_exercise me
JOIN exercise e ON e.id = me.exercise_id AND e.deleted_at IS NULL
WHERE me.machine_id = :machineId
ORDER BY me.position;
